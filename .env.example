# Funnel app — copy to .env and fill in real values.
# (On Render, set these in the service's Environment tab instead.)

# Port the server listens on. Render injects its own PORT automatically.
PORT=3000

# Secret token for the /admin panel (?token=...). CHANGE THIS in production.
ADMIN_TOKEN=<redacted>

# Turso database URL (e.g. libsql://your-db-yourorg.turso.io).
# When BOTH are set, the app uses Turso instead of the local SQLite file.
# Get these from the Turso dashboard (https://turso.tech → your database).
TURSO_DATABASE_URL=

# Turso auth token for the database URL above (turso db tokens create <db-name>).
TURSO_AUTH_TOKEN=

# Email provider: "local" writes every email to data/outbox/ (testing mode,
# no real delivery); "resend" is a non-delivering stub until wired to the
# Resend API with the key below.
EMAIL_PROVIDER=local

# Resend API key — required before EMAIL_PROVIDER=resend can deliver real mail.
RESEND_API_KEY=

# Stripe webhook secret — required before /webhooks/stripe can be trusted in
# production (the stub accepts unsigned payloads and must not be used live).
STRIPE_WEBHOOK_SECRET=

# Operations contact for the TransitNow Driver Operations Platform
# (urgent support alerts, new-driver notifications). Defaults to the site
# email in config/site.json when unset.
TRANSITNOW_OPS_EMAIL=
